{
	"name": "@module-federation/tauri",
	"version": "1.0.1",
	"type": "module",
	"description": "Tauri runtime integration for Module Federation.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/module-federation/tauri.git",
		"directory": "packages/tauri"
	},
	"bugs": {
		"url": "https://github.com/module-federation/tauri/issues"
	},
	"homepage": "https://github.com/module-federation/tauri#readme",
	"keywords": [
		"tauri",
		"module federation",
		"microfrontend"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build",
		"pack:dry": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@module-federation/runtime": "^2.0.0"
	},
	"devDependencies": {
		"@module-federation/runtime": "^2.9.3",
		"@rslib/core": "^1.0.5",
		"typescript": "^5.9.3"
	}
}
