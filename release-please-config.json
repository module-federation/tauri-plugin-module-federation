{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "bump-minor-pre-major": true,
  "changelog-type": "github",
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "package-name": "@module-federation/tauri",
      "changelog-path": "packages/tauri/CHANGELOG.md",
      "exclude-paths": [".github", "docs", "example", "scripts"],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/tauri/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "packages/tauri-plugin/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='tauri-plugin-module-federation')].version"
        }
      ]
    }
  }
}
